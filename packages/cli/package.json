{
  "name": "@causign/cli",
  "version": "0.1.1",
  "description": "CLI for agent testing, discovery and local failure reports",
  "type": "module",
  "bin": {
    "causign": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@causign/adapter-codex": "workspace:*",
    "@causign/adapter-claude-code": "workspace:*",
    "@causign/runtime": "workspace:*",
    "@causign/protocol": "workspace:*",
    "@causign/core": "workspace:*",
    "tsx": "4.23.15",
    "picomatch": "4.0.3"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
