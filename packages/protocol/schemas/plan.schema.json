{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentest.dev/schemas/plan.schema.json",
  "title": "RunPlan",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "$ref": "https://agentest.dev/schemas/config.schema.json#/definitions/AgentReference"
    },
    "protocol": {
      "const": "agentest/1"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input": {
      "$ref": "https://agentest.dev/schemas/scenario.schema.json#/definitions/JsonValue"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interceptions": {
      "type": "array",
      "items": {
        "$ref": "https://agentest.dev/schemas/scenario.schema.json#/definitions/ToolMock"
      }
    },
    "approvalDecisions": {
      "type": "array",
      "items": {
        "$ref": "https://agentest.dev/schemas/scenario.schema.json#/definitions/ApprovalDecision"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "https://agentest.dev/schemas/scenario.schema.json#/definitions/AssertionDefinition"
      }
    },
    "limits": {
      "$ref": "https://agentest.dev/schemas/scenario.schema.json#/definitions/ExecutionLimits"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://agentest.dev/schemas/scenario.schema.json#/definitions/JsonValue"
      }
    }
  },
  "required": [
    "id",
    "scenarioId",
    "agent",
    "protocol",
    "capabilities",
    "input",
    "requirements",
    "interceptions",
    "approvalDecisions",
    "assertions",
    "limits"
  ],
  "additionalProperties": false,
  "definitions": {}
}
